# Required for the Discord bot. Fill in .env locally only; never commit it.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands in one development server.
DISCORD_GUILD_ID=
DATABASE_PATH=./data/amazon-bot.sqlite

# API-free V1: no Amazon API credentials are required or read.
# Product mode, marketplace tracking IDs and OneLink declaration are set with
# /amazon setup and stored in the database, not in this file.
