# Copy to .env locally. Never share or commit the real file.
# Use a dedicated Discord application, NOT your existing GamerHQ bot token.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# For the server test, this is REQUIRED. It also restricts runtime handling to this server.
DISCORD_GUILD_ID=
DATABASE_PATH=./data/amazon-test.sqlite

# Amazon API access is OPTIONAL. Basic/Affiliate link features do not need it.
# Configure marketplace tracking IDs and optional OneLink declaration through /amazon setup.
#
# Optional Creators API diagnostic (do not commit real values):
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
#
# Registration is explicit: npm run commands:register (after npm run build).
