# Required to run the Discord bot; fill in .env locally only.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in one development server.
DISCORD_GUILD_ID=
DATABASE_PATH=./data/amazon-bot.sqlite

# Reserved for the next Creators API access-test slice.
# These variables are NOT consumed by the v0.3 bot yet.
# Never paste credentials into Discord, issues, prompts, or logs.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
# Diagnostic-only configuration; production marketplace settings belong in the DB.
AMAZON_CREATORS_MARKETPLACE=www.amazon.de
AMAZON_CREATORS_PARTNER_TAG=
